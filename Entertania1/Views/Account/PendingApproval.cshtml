@{
    ViewData["Title"] = "Pending Approval";
}

<link rel="stylesheet" href="~/css/Account/PendingApproval.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-body text-center p-5">
                <!-- Hourglass Icon -->
                <div class="mb-4">
                    <i class="bi bi-hourglass-split" style="font-size: 5rem; color:  #C59D5F;"></i>
                </div>

                <!-- Heading -->
                <h2 class="mb-3">Account Pending Approval</h2>

                <!-- Message -->
                <div class="alert alert-warning mb-4">
                    <p class="mb-0">
                        <strong>Thank you for registering as an organizer!</strong>
                    </p>
                    <p class="mb-0 mt-2">
                        Your account is currently under review by our admin team.
                    </p>
                </div>

                <!-- Status Info -->
                <div class="text-start mb-4">
                    <h5 class="mb-3">What happens next:</h5>
                    <ul class="list-group">
                        <li class="list-group-item d-flex align-items-start">
                            <i class="bi bi-check-circle text-success me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <div class="fw-bold">Email Confirmed</div>
                                <small class="text-muted">Your email has been verified</small>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-start">
                            <i class="bi bi-hourglass-split text-warning me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <div class="fw-bold">Document Review</div>
                                <small class="text-muted">Our team is reviewing your verification documents</small>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-start">
                            <i class="bi bi-envelope text-primary me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <div class="fw-bold">Email Notification</div>
                                <small class="text-muted">You'll receive an email once your account is approved</small>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Timeline -->
                <div class="bg-light p-4 rounded mb-4">
                    <p class="mb-2">
                        <i class="bi bi-clock"></i>
                        <strong>Review Time:</strong> Usually 1-3 business days
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-question-circle"></i>
                        <strong>Questions?</strong> Contact us at
                        <a href="mailto:entertaniateam@gmail.com">entertaniateam@gmail.com</a>
                    </p>
                </div>

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-lg w-100">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

