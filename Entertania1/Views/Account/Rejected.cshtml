@{
    ViewData["Title"] = "Account Rejected";
}

<link rel="stylesheet" href="~/css/Account/Rejected.css" asp-append-version="true" />

<div class="text-center mt-5">
    <h2 class="text-danger">Your Organizer Account Was Rejected</h2>
    <p class=" mt-3">
        Unfortunately, your request to join as an organizer has been rejected by the admin team.
        You won’t be able to access organizer features.
    </p>
    <p>
        If you believe this was a mistake or wish to appeal, please contact support or reapply.
    </p>
    <a asp-action="Register" class="btn btn-outline-primary mt-3">Back to Register an Account</a>
</div>
