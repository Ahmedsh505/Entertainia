@model Entertania1.ViewModels.Account.Verify2FAVM

@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<link rel="stylesheet" href="~/css/Account/Verify2FA.css" asp-append-version="true" />

<div class="auth-container">
    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="auth-title">Two-Factor Authentication</h1>
            <p class="auth-subtitle">Enter the 6-digit code sent to your email</p>
        </div>

        <!-- Body -->
        <div class="auth-body">

            <form asp-action="Verify2FA" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-4">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code"
                           class="form-control text-center"
                           style="font-size:24px; letter-spacing:10px;"
                           maxlength="6"
                           placeholder="000000" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth w-100">Verify</button>
            </form>

            <div class="mt-3 text-center">
                <small class="text-muted">Code expires in 10 minutes</small>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
