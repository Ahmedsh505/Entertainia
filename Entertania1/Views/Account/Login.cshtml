@model Entertania1.ViewModels.Account.LoginVM
@{
    ViewData["Title"] = "Login";
}
<link rel="stylesheet" href="~/css/Account/login.css" asp-append-version="true" />
<div class="auth-wrapper">
    <div class="auth-background">
        <div class="auth-particles">
            <div class="auth-particle"></div>
            <div class="auth-particle"></div>
            <div class="auth-particle"></div>
            <div class="auth-particle"></div>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="auth-card">
                    <!-- Header -->
                    <div class="auth-header">
                        <div class="auth-icon">
                            <i class="bi bi-box-arrow-in-right"></i>
                        </div>
                        <h1 class="auth-title">Welcome Back</h1>
                        <p class="auth-subtitle">Sign in to access your account</p>
                    </div>

                    <!-- Success/Info/Warning/Error Messages -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@TempData["Success"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>@TempData["Info"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Warning"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@Html.Raw(TempData["Warning"])</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>@TempData["Error"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }


                    <!-- Login Form -->
                    <form asp-action="Login" method="post">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="All" class="validation-summary-errors"></div>

                        <div class="form-group">
                            <label asp-for="Identifier" class="form-label">
                                <i class="bi bi-person-circle"></i>
                                <span>Email or Username</span>
                            </label>
                            <input asp-for="Identifier"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your email or username"
                                   autofocus />
                            <span asp-validation-for="Identifier" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-lock-fill"></i>
                                <span>Password</span>
                            </label>
                            <input asp-for="Password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="remember-me-wrapper">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label">
                                    Remember me
                                </label>
                            </div>
                            <a asp-action="ForgotPassword" class="forgot-link">
                                <i class="bi bi-question-circle"></i>
                                <span>Forgot password?</span>
                            </a>
                        </div>

                        <button type="submit" class="btn btn-submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="divider">
                        <span>or</span>
                    </div>

                    <!-- Register Section -->
                    <div class="register-section">
                        <p class="register-text">
                            Don't have an account yet?
                        </p>
                        <a asp-action="Register" class="btn btn-register">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/Acc_login.js" asp-append-version="true"></script>