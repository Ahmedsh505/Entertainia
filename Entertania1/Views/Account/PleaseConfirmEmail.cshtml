@{
    ViewData["Title"] = "Confirm Your Email";
    var email = ViewBag.Email as string;
    var role = ViewBag.Role as string;
}

<link rel="stylesheet" href="~/css/Account/PleaseConfirmEmail.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">
                    <!-- Email Icon -->
                    <div class="mb-4">
                        <i class="bi bi-envelope-check" style="font-size: 5rem; color: #0d6efd;"></i>
                    </div>

                    <!-- Heading -->
                    <h2 class="mb-3">Confirm Your Email Address</h2>

                    <!-- Message -->
                    <div class="alert alert-info mb-4">
                        <p class="mb-0">
                            <strong>Almost there!</strong> We've sent a confirmation email to:
                        </p>
                        <p class="mb-0 mt-2">
                            <strong class="text-primary">@email</strong>
                        </p>
                    </div>

                    <!-- Instructions -->
                    <div class="text-start mb-4">
                        <h5 class="mb-3">What to do next:</h5>
                        <ol class="list-group list-group-numbered">
                            <li class="list-group-item d-flex align-items-start">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold">Check your inbox</div>
                                    Look for an email from Entertania Team
                                </div>
                            </li>
                            <li class="list-group-item d-flex align-items-start">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold">Click the confirmation link</div>
                                    Open the email and click the verification link
                                </div>
                            </li>
                            <li class="list-group-item d-flex align-items-start">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold">
                                        @if (role == "Organizer")
                                        {
                                            <text>Wait for admin approval</text>
                                        }
                                        else
                                        {
                                            <text>Start exploring!</text>
                                        }
                                    </div>
                                    @if (role == "Organizer")
                                    {
                                        <text>After confirmation, your application will be reviewed by our team</text>
                                    }
                                    else
                                    {
                                        <text>Once confirmed, you can log in and book events</text>
                                    }
                                </div>
                            </li>
                        </ol>
                    </div>

                    <!-- Resend Form -->
                    <div class="bg-light p-4 rounded mb-3">
                        <p class="mb-3">
                            <i class="bi bi-question-circle"></i> Didn't receive the email?
                        </p>
                        <form asp-action="ResendConfirmationEmail" method="post" class="d-inline">
                            <input type="hidden" name="email" value="@email" />
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-clockwise"></i> Resend Confirmation Email
                            </button>
                        </form>
                    </div>

                    <!-- Help Text -->
                    <div class="text-muted small">
                        <p class="mb-2">
                            <i class="bi bi-info-circle"></i>
                            <strong>Tip:</strong> Check your spam or junk folder if you don't see the email
                        </p>
                        <p class="mb-0">
                            <i class="bi bi-clock"></i>
                            The confirmation link is valid for 24 hours
                        </p>
                    </div>

                    <!-- Back to Login -->
                    <hr class="my-4">
                    <p class="mb-0">
                        Already confirmed?
                        <a asp-action="Login" class="btn btn-link">
                            Go to Login <i class="bi bi-arrow-right"></i>
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Auto-refresh notification -->
<script>
    // Optional: Show a toast notification after resend
    @if (TempData["Success"] != null)
    {
                <text>
                setTimeout(function() {
                    alert('@TempData["Success"]');
                }, 100);
                </text>
    }
    @if (TempData["Error"] != null)
    {
                <text>
                setTimeout(function() {
                    alert('@TempData["Error"]');
                }, 100);
                </text>
    }
</script>

