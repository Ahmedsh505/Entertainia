@{
    ViewData["Title"] = "Ticket Not Found";
    var errorMessage = ViewBag.ErrorMessage as string ?? "Ticket not found";
}
<link rel="stylesheet" href="~/css/Ticket/TicketNotFound.css" />

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-danger">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0">
                        <i class="fas fa-times-circle"></i>
                        Ticket Not Found
                    </h3>
                </div>
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-ticket-alt" style="font-size: 80px; color: #dc3545; opacity: 0.3;"></i>
                    </div>

                    <div class="alert alert-danger">
                        <h4><strong>@errorMessage</strong></h4>
                    </div>

                    <p class="text-muted">
                        This ticket could not be found or is invalid. Please check your booking details or contact support.
                    </p>

                    <div class="mt-4">
                        <a href="@Url.Action("MyBookings", "Booking")" class="btn btn-primary me-2">
                            <i class="fas fa-list"></i> My Bookings
                        </a>
                        <a href="/" class="btn btn-outline-secondary">
                            <i class="fas fa-home"></i> Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>