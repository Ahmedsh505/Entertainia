@using Core.Models.EventModels
@model EventBase

@{
    ViewData["Title"] = "Delete Event";
}
<link rel="stylesheet" href="~/css/Events/EventDelete.css" />

<h2>Delete Event</h2>
<h4>Are you sure you want to delete this event?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Start Date</dt>
    <dd class="col-sm-10">@Model.StartDate</dd>

    <dt class="col-sm-2">End Date</dt>
    <dd class="col-sm-10">@Model.EndDate</dd>

    <dt class="col-sm-2">Venue</dt>
    <dd class="col-sm-10">@Model.Venue.Location</dd>

    <dt class="col-sm-2">Organizer</dt>
    <dd class="col-sm-10">@Model.Organizer.Address</dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category</dd>
</dl>

<div class="mt-4 d-flex gap-3">
    <form asp-action="Delete">
        <input type="hidden" asp-for="EventId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</div>
