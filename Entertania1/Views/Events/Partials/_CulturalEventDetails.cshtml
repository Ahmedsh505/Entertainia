@using Core.Models.EventModels
@model CulturalEvent

@if (Model != null)
{
    <div class="info-card fade-in">
        <div class="card-header-custom">
            <h3 class="section-title">
                <i class="fas fa-globe"></i>
                Cultural Event Details
            </h3>
        </div>
        <div class="card-body-custom">
            <div class="info-block">
                <div class="info-label">
                    <i class="fas fa-user-tie"></i>
                    Organizer Name
                </div>
                <div class="info-content">@Model.OrganizerName</div>
            </div>

            <div class="info-block">
                <div class="info-label">
                    <i class="fas fa-bookmark"></i>
                    Topic
                </div>
                <div class="info-content">@Model.Topic</div>
            </div>

            <div class="info-block">
                <div class="info-label">
                    <i class="fas fa-language"></i>
                    Language
                </div>
                <div class="info-content">@Model.Language</div>
            </div>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-globe"></i>
        <p>No cultural event details available</p>
    </div>
}