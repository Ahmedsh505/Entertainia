@using Core.Models.EventModels
@model TheaterPlay

<div id="theaterplayfields" class="category-section">
    <h4>🎭 Theater Play Details</h4>

    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" name="TheaterPlay.Director" />
    </div>

    <div class="form-group">
        <label asp-for="ActorsList"></label>
        <input asp-for="ActorsList" class="form-control" name="TheaterPlay.ActorsList" />
    </div>

    <div class="form-group">
        <label asp-for="DurationMinutes"></label>
        <input asp-for="DurationMinutes" type="number" class="form-control" name="TheaterPlay.DurationMinutes" />
    </div>
</div>