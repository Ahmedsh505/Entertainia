@model IEnumerable<Entertania1.ViewModels.PaymentHistory.PaymentHistoryVM>

@{
    ViewData["Title"] = "My Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/PaymentHistory.css" />
</head>
<body>
    <div class="payment-history-container">
        <!-- HEADER -->
        <div class="page-header">
            <h1 class="page-title">💳 Payment History</h1>
            <p class="page-subtitle">Track all your transactions, refunds, and booking history</p>
        </div>

        @if (!Model.Any())
        {
            <!-- EMPTY STATE -->
            <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <h2 class="empty-state-title">No Payment History Yet</h2>
                <p class="empty-state-text">Your payment transactions will appear here once you start booking events.</p>
                <a href="@Url.Action("Index", "Events")" class="btn btn-primary">
                    🎫 Browse Events
                </a>
            </div>
        }
        else
        {
            <!-- TRANSACTIONS GRID -->
            <div class="transactions-grid">
                @foreach (var payment in Model)
                {
                    var index = Model.ToList().IndexOf(payment);

                    <!-- TRANSACTION CARD - COMPACT DESIGN -->
                    <div class="transaction-card" data-index="@index">
                        <!-- Header Row -->
                        <div class="card-header-row">
                            <div class="event-info">
                                <h3 class="event-name" title="@payment.EventName">@payment.EventName</h3>
                                <span class="transaction-badge @(payment.IsRefund ? "badge-refund" : payment.IsCancellation ? "badge-cancellation" : "badge-payment")">
                                    @payment.Icon @payment.TransactionType
                                </span>
                            </div>
                            <div class="amount-display">
                                <div class="amount-value @(payment.IsRefund ? "amount-negative" : payment.IsCancellation ? "amount-neutral" : "amount-positive")">
                                    @if (payment.IsRefund)
                                    {
                                        <span>-@payment.FormattedAmount</span>
                                    }
                                    else if (payment.IsCancellation)
                                    {
                                        <span>$0.00</span>
                                    }
                                    else
                                    {
                                        <span>+@payment.FormattedAmount</span>
                                    }
                                </div>
                         </div>
                        </div>

                        <!-- Refund Info (if applicable) -->
                        @if (payment.IsRefund && payment.OriginalAmount.HasValue && payment.OriginalAmount > 0)
                        {
                            <div class="refund-info">
                                <div class="refund-details">
                                    <div class="refund-calculation-group">
                                        <span class="refund-label">Original Payment:</span>
                                        <span class="refund-original">$@payment.OriginalAmount.Value.ToString("N2")</span>
                                    </div>
                                    <div class="refund-calculation-group">
                                        <span class="refund-label">Refund Amount (80%):</span>
                                        <span class="refund-final">@payment.FormattedAmount</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Info Grid -->
                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-label">Date</div>
                                <div class="info-value">@payment.UpdatedAt.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Status</div>
                                <div class="info-value">
                                    <span class="status-badge status-@payment.Status.ToString().ToLower()">
                                        @payment.Icon @payment.StatusText
                                    </span>
                                </div>
                            </div>
                            @if (payment.IsRefund && payment.OriginalAmount.HasValue)
                            {
                                <div class="info-item">
                                    <div class="info-label">Original Amount</div>
                                    <div class="info-value">$@payment.OriginalAmount.Value.ToString("N2")</div>
                                </div>
                            }
                            <div class="info-item">
                                <div class="info-label">Method</div>
                                <div class="info-value">@payment.DisplayMethod</div>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <button class="view-details-btn" onclick="event.stopPropagation(); openModal(@index)">
                            View Full Details
                        </button>
                    </div>

                    <!-- MODAL FOR THIS TRANSACTION -->
                    <div class="modal-overlay" id="modal-overlay-@index" onclick="closeModal(@index)"></div>
                    <div class="modal-container" id="modal-@index">
                        <div class="modal-header">
                            <h2 class="modal-title">📄 Transaction Details</h2>
                            <button class="modal-close" onclick="closeModal(@index)">×</button>
                        </div>
                        <div class="modal-body">
                            <!-- Transaction Summary -->
                            <div class="detail-section">
                                <h3 class="section-title">💰 Transaction Summary</h3>
                                <div class="detail-grid">
                                    <div class="detail-card">
                                        <div class="detail-label">Event Name</div>
                                        <div class="detail-value">@payment.EventName</div>
                                    </div>
                                    <div class="detail-card">
                                        <div class="detail-label">Transaction Type</div>
                                        <div class="detail-value">
                                            @if (payment.IsRefund)
                                            {
                                                <span>Refund</span>
                                            }
                                            else if (payment.IsCancellation)
                                            {
                                                <span>Cancellation</span>
                                            }
                                            else
                                            {
                                                <span>Payment</span>
                                            }
                                        </div>
                                    </div>

                                    @if (payment.IsRefund && payment.OriginalAmount.HasValue && payment.OriginalAmount > 0)
                                    {
                                        <div class="detail-card">
                                            <div class="detail-label">Original Payment</div>
                                            <div class="detail-value">$@payment.OriginalAmount.Value.ToString("N2")</div>
                                        </div>
                                        <div class="detail-card">
                                            <div class="detail-label">Refund Amount (80%)</div>
                                            <div class="detail-value highlight">@payment.FormattedAmount</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="detail-card">
                                            <div class="detail-label">Amount</div>
                                            <div class="detail-value highlight">@payment.FormattedAmount</div>
                                        </div>
                                    }
                                    <div class="detail-card">
                                        <div class="detail-label">Payment Method</div>
                                        <div class="detail-value">@payment.DisplayMethod</div>
                                    </div>
                                    <div class="detail-card">
                                        <div class="detail-label">Current Status</div>
                                        <div class="detail-value">
                                            <span class="status-badge status-@payment.Status.ToString().ToLower()">
                                                @payment.Icon @payment.StatusText
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Important Dates -->
                            <div class="detail-section">
                                <h3 class="section-title">📅 Important Dates</h3>
                                <div class="detail-grid">
                                    <div class="detail-card">
                                        <div class="detail-label">Transaction Created</div>
                                        <div class="detail-value">@payment.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                                    </div>
                                    <div class="detail-card">
                                        <div class="detail-label">Last Updated</div>
                                        <div class="detail-value">@payment.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                                    </div>
                                    @if (payment.IsRefund)
                                    {
                                        @if (payment.Status == Core.Enums.PaymentStatus.Pending)
                                        {
                                            <div class="detail-card">
                                                <div class="detail-label">Refund Requested</div>
                                                <div class="detail-value">@payment.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                                            </div>
                                        }
                                        @if (payment.Status == Core.Enums.PaymentStatus.Processing)
                                        {
                                            <div class="detail-card">
                                                <div class="detail-label">Refund Approved</div>
                                                <div class="detail-value">@payment.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                                            </div>
                                        }
                                        @if (payment.Status == Core.Enums.PaymentStatus.Refunded)
                                        {
                                            <div class="detail-card">
                                                <div class="detail-label">Refund Completed</div>
                                                <div class="detail-value">@payment.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                                            </div>
                                        }
                                        @if (payment.Status == Core.Enums.PaymentStatus.RefundRejected)
                                        {
                                            <div class="detail-card">
                                                <div class="detail-label">Refund Rejected</div>
                                                <div class="detail-value">@payment.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Status Timeline -->
                            @if (payment.StatusHistory.Count > 0)
                            {
                                <div class="detail-section timeline-section">
                                    <h3 class="section-title">⏱️ Status Timeline</h3>
                                    <div class="timeline">
                                        @foreach (var item in payment.StatusHistory)
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker">@item.Icon</div>
                                                <div class="timeline-content">
                                                    <div class="timeline-status">@item.StatusText</div>
                                                    <div class="timeline-date">@item.Timestamp.ToString("MMM dd, yyyy hh:mm tt")</div>
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <div class="timeline-description">@item.Description</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Additional Information -->
                            <div class="info-box">
                                <p class="info-box-text">
                                    <strong>ℹ️ @payment.GetDescription()</strong>
                                </p>
                            </div>

                            @if (payment.IsRefund && payment.Status == Core.Enums.PaymentStatus.Refunded)
                            {
                                <div class="info-box" style="margin-top: 12px;">
                                    <p class="info-box-text">
                                        <strong>💡 Refund Processing Time:</strong> Refunded amounts typically appear in your account within 5-7 business days, depending on your bank or payment provider.
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

         
        }

        <!-- ACTION BUTTONS -->
        <div class="action-buttons">
            <a href="@Url.Action("MyBookings", "Booking")" class="btn btn-secondary">
                ← Back to Bookings
            </a>
            <a href="@Url.Action("Index", "Events")" class="btn btn-primary">
                🎫 Browse Events
            </a>
        </div>
    </div>

    <script src="~/js/PaymentHistory.js"></script>
</body>
</html>