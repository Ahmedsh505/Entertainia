@* 
    Reusable photo gallery upload component
    Usage: @await Html.PartialAsync("_PhotoGalleryUpload", new { entityType = "event", entityId = Model.Event.EventId })
*@

@{
    var entityType = ViewData["entityType"] as string ?? "event";
    var entityId = ViewData["entityId"] as int? ?? 0;
    var existingPhotos = ViewData["existingPhotos"] as List<dynamic> ?? new List<dynamic>();
}

<div class="card mb-3">
    <div class="card-header bg-info text-white">
        <h5><i class="fas fa-images"></i> Photo Gallery</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <strong>Photo Guidelines:</strong>
            <ul class="mb-0 mt-2">
                <li>Upload up to 8 photos</li>
                <li>Supported formats: JPG, PNG, WEBP</li>
                <li>Maximum size: 5 MB per photo</li>
                <li>First photo will be the cover photo (you can change this later)</li>
            </ul>
        </div>

        <!-- Existing Photos (for edit mode) -->
        @if (existingPhotos.Any())
        {
            <div class="mb-4">
                <h6 class="fw-bold">Current Photos</h6>
                <div id="existingPhotosGrid" class="photo-grid">
                    @foreach (var photo in existingPhotos)
                    {
                        <div class="photo-item" data-photo-id="@photo.Id">
                            <img src="@photo.Path" alt="Photo" />
                            <div class="photo-overlay">
                                @if (photo.IsPrimary)
                                {
                                    <span class="badge bg-success primary-badge">
                                        <i class="fas fa-star"></i> Cover
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-success"
                                            onclick="setPrimaryPhoto(@photo.Id)">
                                        <i class="fas fa-star"></i> Set as Cover
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="deletePhoto(@photo.Id)">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Photo Upload Area -->
        <div class="upload-area" id="uploadArea">
            <div class="upload-content">
                <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                <h5>Drag & Drop Photos Here</h5>
                <p class="text-muted">or click to browse</p>
                <input type="file"
                       id="photoInput"
                       name="photos"
                       accept="image/jpeg,image/png,image/webp"
                       multiple
                       hidden />
            </div>
        </div>

        <!-- Preview Grid -->
        <div id="previewGrid" class="photo-grid mt-3" style="display: none;"></div>

        <!-- Upload Progress -->
        <div id="uploadProgress" class="mt-3" style="display: none;">
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: 0%">
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Uploading photos...</small>
        </div>
    </div>
</div>

<style>
    .upload-area {
        border: 3px dashed #cbd5e0;
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f8f9fa;
    }

        .upload-area:hover, .upload-area.dragover {
            border-color: #667eea;
            background: #eef2ff;
        }

        .upload-area.dragover {
            transform: scale(1.02);
        }

    .photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
    }

    .photo-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

        .photo-item:hover {
            transform: scale(1.05);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .photo-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .photo-item:hover .photo-overlay {
        opacity: 1;
    }

    .primary-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        opacity: 1 !important;
    }

    .preview-item {
        position: relative;
    }

    .remove-preview {
        position: absolute;
        top: 5px;
        right: 5px;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .preview-item:hover .remove-preview {
        opacity: 1;
    }
</style>

<script>
    const maxPhotos = 8;
    const maxSize = 5 * 1024 * 1024; // 5 MB
    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
    let selectedFiles = [];

    document.addEventListener('DOMContentLoaded', function() {
        const uploadArea = document.getElementById('uploadArea');
        const photoInput = document.getElementById('photoInput');
        const previewGrid = document.getElementById('previewGrid');

        // Click to upload
        uploadArea.addEventListener('click', () => photoInput.click());

        // Drag and drop
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            handleFiles(e.dataTransfer.files);
        });

        // File input change
        photoInput.addEventListener('change', (e) => {
            handleFiles(e.target.files);
        });
    });

    function handleFiles(files) {
        const fileArray = Array.from(files);
        const previewGrid = document.getElementById('previewGrid');

        // Validate file count
        const existingCount = document.querySelectorAll('#existingPhotosGrid .photo-item').length;
        const totalCount = existingCount + selectedFiles.length + fileArray.length;

        if (totalCount > maxPhotos) {
            alert(`Maximum ${maxPhotos} photos allowed. You can upload ${maxPhotos - existingCount - selectedFiles.length} more.`);
            return;
        }

        // Validate and add files
        fileArray.forEach(file => {
            if (!allowedTypes.includes(file.type)) {
                alert(`${file.name} is not a supported image format.`);
                return;
            }

            if (file.size > maxSize) {
                alert(`${file.name} exceeds maximum size of 5 MB.`);
                return;
            }

            selectedFiles.push(file);
            createPreview(file);
        });

        previewGrid.style.display = selectedFiles.length > 0 ? 'grid' : 'none';
    }

    function createPreview(file) {
        const previewGrid = document.getElementById('previewGrid');
        const reader = new FileReader();

        reader.onload = (e) => {
            const div = document.createElement('div');
            div.className = 'photo-item preview-item';
            div.innerHTML = `
                <img src="${e.target.result}" alt="Preview" />
                <button type="button" class="remove-preview" onclick="removePreview(this, '${file.name}')">
                    <i class="fas fa-times"></i>
                </button>
            `;
            previewGrid.appendChild(div);
        };

        reader.readAsDataURL(file);
    }

    function removePreview(button, fileName) {
        const index = selectedFiles.findIndex(f => f.name === fileName);
        if (index > -1) {
            selectedFiles.splice(index, 1);
        }

        button.closest('.preview-item').remove();

        const previewGrid = document.getElementById('previewGrid');
        previewGrid.style.display = selectedFiles.length > 0 ? 'grid' : 'none';
    }

    // AJAX functions for existing photos
    async function deletePhoto(photoId) {
        if (!confirm('Are you sure you want to delete this photo?')) return;

        try {
            const response = await fetch(`/api/photos/${photoId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (response.ok) {
                document.querySelector(`[data-photo-id="${photoId}"]`).remove();
                showToast('Photo deleted successfully', 'success');
            } else {
                showToast('Failed to delete photo', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('An error occurred', 'error');
        }
    }

    async function setPrimaryPhoto(photoId) {
        try {
            const response = await fetch(`/api/photos/${photoId}/set-primary`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (response.ok) {
                location.reload(); // Reload to update UI
            } else {
                showToast('Failed to set primary photo', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('An error occurred', 'error');
        }
    }

    function showToast(message, type) {
        // Simple toast notification (you can replace with your preferred toast library)
        alert(message);
    }
</script>