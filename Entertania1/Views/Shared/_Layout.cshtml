@inject Microsoft.AspNetCore.Identity.UserManager<Core.Models.User> UserManager
@{
    var currentUser = User.Identity.IsAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var userInitials = "";
    if (currentUser != null)
    {
        userInitials = (!string.IsNullOrEmpty(currentUser.FirstName) ? currentUser.FirstName[0].ToString() : "") +
                       (!string.IsNullOrEmpty(currentUser.LastName) ? currentUser.LastName[0].ToString() : "");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Entertania</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/uploads/Logo/logo.png" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Components/Footer.css" asp-append-version="true" />

    <!-- 3. Layout-specific styles -->
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/Entertania1.styles.css" asp-append-version="true" />
    
    <!-- 4. Logo styles -->
    <link rel="stylesheet" href="~/css/logo-styles.css" asp-append-version="true" />

    <!-- 5. Rounded design fixes -->
    <link rel="stylesheet" href="~/css/rounded-design.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    @RenderSection("Styles", required: false)

</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Entertania</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Home link - visible to everyone *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        @* Events - visible to everyone *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event"></i> Events
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Booking" asp-action="MyBookings">
                                        <i class="bi bi-ticket-perforated"></i> My Bookings
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="PaymentHistory" asp-action="Index">
                                        <i class="bi bi-currency-dollar"></i> Payment History
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Organizer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Venue" asp-action="Index">
                                        <i class="bi bi-building"></i> My Venues
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organizer" asp-action="Dashboard">
                                        <i class="bi bi-graph-up"></i> Dashboard
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Venue" asp-action="Index">
                                        <i class="bi bi-building"></i> All Venues
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow"></i> Analytics
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="RefundRequests">
                                        <i class="bi bi-shield-check"></i> Refund
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-shield-check"></i> Management
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people"></i> Users
                                    </a>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Abous_Us">
                                <i class="bi bi-info-circle"></i> About
                            </a>
                        </li>
                    </ul>

                    <!-- Right-side Auth Section -->
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated && currentUser != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(currentUser.ProfilePicturePath))
                                    {
                                        <img src="@currentUser.ProfilePicturePath"
                                             alt="@currentUser.FirstName"
                                             class="nav-profile-picture" />
                                    }
                                    else
                                    {
                                        <span class="nav-profile-initials">@userInitials.ToUpper()</span>
                                    }
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="MyProfile">
                                            <i class="bi bi-person"></i> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="EditProfile">
                                            <i class="bi bi-pencil"></i> Edit Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword">
                                            <i class="bi bi-key"></i> Change Password
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Email Confirmation Banner -->
    @if (User.Identity.IsAuthenticated && currentUser != null && !currentUser.EmailConfirmed)
    {
        <div class="alert alert-warning alert-dismissible fade show m-0 rounded-0 text-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Email Not Confirmed!</strong>
            Please check your inbox and confirm your email address to access all features.
            <form asp-controller="Account" asp-action="ResendConfirmationEmail" method="post" class="d-inline">
                <input type="hidden" name="email" value="@currentUser.Email" />
                <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">
                    Resend confirmation email
                </button>
            </form>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Notification Container -->
    <div id="notification-container"></div>

    <div style="width: 100%; padding: 12px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer class="premium-footer">
            <!-- Premium Egyptian-themed Footer -->
            <footer class="premium-footer">
                <!-- Wave Decoration -->
                <div class="footer-wave">
                    <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
                        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"></path>
                    </svg>
                </div>

                <div class="container">
                    <!-- Main Footer Content -->
                    <div class="footer-content">
                        <!-- Company Section -->
                        <div class="footer-section footer-about">
                            <div class="footer-logo-container">
                                <div class="footer-logo">Entertania</div>
                                <div class="footer-logo-tagline">Experience Entertainment</div>
                            </div>
                            <p class="footer-description">
                                Your premier destination for unforgettable entertainment experiences.
                                From concerts to theater, sports to cultural events – we bring joy to life.
                            </p>

                            <!-- Newsletter Signup -->
                            <div class="footer-newsletter">
                                <h4 class="newsletter-title">Stay Updated</h4>
                                <form class="newsletter-form" onsubmit="handleNewsletterSubmit(event)">
                                    <div class="newsletter-input-group">
                                        <i class="bi bi-envelope-fill"></i>
                                        <input type="email"
                                               placeholder="Your email address"
                                               required
                                               class="newsletter-input"
                                               id="newsletterEmail">
                                    </div>
                                    <button type="submit" class="newsletter-btn">
                                        <span>Subscribe</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Quick Links -->
                        <div class="footer-section">
                            <h3 class="footer-title">Quick Links</h3>
                            <ul class="footer-links">
                                <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i>Home</a></li>
                                <li><a asp-controller="Events" asp-action="Index"><i class="bi bi-chevron-right"></i>Events</a></li>
                                <li><a asp-controller="Home" asp-action="Abous_Us"><i class="bi bi-chevron-right"></i>About Us</a></li>
                                <li><a href="#reviewsSection"><i class="bi bi-chevron-right"></i>Reviews</a></li>
                                <li><a href="#contact"><i class="bi bi-chevron-right"></i>Contact</a></li>
                            </ul>
                        </div>

                        <!-- Categories -->
                        <div class="footer-section">
                            <h3 class="footer-title">Categories</h3>
                            <ul class="footer-links">
                                <li><a href="#"><i class="bi bi-chevron-right"></i>Concerts</a></li>
                                <li><a href="#"><i class="bi bi-chevron-right"></i>Theater</a></li>
                                <li><a href="#"><i class="bi bi-chevron-right"></i>Sports Events</a></li>
                                <li><a href="#"><i class="bi bi-chevron-right"></i>Cultural Shows</a></li>
                                <li><a href="#"><i class="bi bi-chevron-right"></i>Festivals</a></li>
                            </ul>
                        </div>

                        <!-- Contact Info -->
                        <div class="footer-section">
                            <h3 class="footer-title">Get in Touch</h3>
                            <ul class="footer-contact">
                                <li>
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <div>
                                        <strong>Address</strong>
                                        <span>Sharqia, Egypt</span>
                                    </div>
                                </li>
                                <li>
                                    <i class="bi bi-telephone-fill"></i>
                                    <div>
                                        <strong>Phone</strong>
                                        <span>+20 10 929 60 582</span>
                                    </div>
                                </li>
                                <li>
                                    <i class="bi bi-envelope-fill"></i>
                                    <div>
                                        <strong>Email</strong>
                                        <span>EntertaniaTeam@gmail.com</span>
                                    </div>
                                </li>
                                <li>
                                    <i class="bi bi-clock-fill"></i>
                                    <div>
                                        <strong>Support Hours</strong>
                                        <span>24/7 Available</span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Social Media & Bottom Bar -->
                    <div class="footer-bottom">
                        <div class="footer-social">
                            <h4>Follow Us</h4>
                            <div class="social-links">
                                <a href="#" class="social-link" title="Facebook">
                                    <i class="bi bi-facebook"></i>
                                </a>
                                <a href="#" class="social-link" title="Twitter">
                                    <i class="bi bi-twitter"></i>
                                </a>
                                <a href="#" class="social-link" title="Instagram">
                                    <i class="bi bi-instagram"></i>
                                </a>
                                <a href="#" class="social-link" title="LinkedIn">
                                    <i class="bi bi-linkedin"></i>
                                </a>
                                <a href="#" class="social-link" title="YouTube">
                                    <i class="bi bi-youtube"></i>
                                </a>
                            </div>
                        </div>

                        <div class="footer-divider"></div>

                        <div class="footer-legal">
                            <div class="copyright">
                                <i class="bi bi-c-circle"></i>
                                <span>2024 Entertania. All rights reserved.</span>
                            </div>
                            <div class="legal-links">
                                <a href="#">Privacy Policy</a>
                                <a href="#">Terms of Service</a>
                                <a href="#">Cookie Policy</a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>

            <script>
                function handleNewsletterSubmit(event) {
                    event.preventDefault();
                    const email = document.getElementById('newsletterEmail').value;
                    // Add your newsletter subscription logic here
                    alert('Thank you for subscribing! We\'ll keep you updated with the latest events.');
                    document.getElementById('newsletterEmail').value = '';
                }

                function scrollToTop() {
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                }

                // Show back to top button on scroll
                window.addEventListener('scroll', function() {
                    const backToTopBtn = document.querySelector('.footer-back-to-top');
                    if (window.pageYOffset > 300) {
                        backToTopBtn.classList.add('show');
                    } else {
                        backToTopBtn.classList.remove('show');
                    }
                });
            </script>
        </footer>
    </div>

    <!-- Scroll to Top Button -->
    <button id="scrollTopBtn" title="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Navbar scroll effect
        $(window).scroll(function () {
            if ($(this).scrollTop() > 50) {
                $('.navbar').addClass('scrolled');
            } else {
                $('.navbar').removeClass('scrolled');
            }

            // Show/hide scroll to top button
            if ($(this).scrollTop() > 300) {
                $('#scrollTopBtn').addClass('show');
            } else {
                $('#scrollTopBtn').removeClass('show');
            }
        });

        // Scroll to top functionality
        $('#scrollTopBtn').click(function () {
            $('html, body').animate({ scrollTop: 0 }, 600);
        });

        // Active nav link highlighting
        $(document).ready(function () {
            var currentPath = window.location.pathname;
            $('.nav-link').each(function () {
                var href = $(this).attr('href');
                if (href && currentPath.includes(href) && href !== '/') {
                    $(this).addClass('active');
                }
            });

            // Highlight home link on home page
            if (currentPath === '/' || currentPath === '/Home' || currentPath === '/Home/Index') {
                $('.nav-link[href="/"]').addClass('active');
            }
        });

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            $('.alert:not(.alert-warning)').fadeOut('slow');
        }, 5000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script type="text/javascript">
        window.$crisp=[];
            window.CRISP_WEBSITE_ID="6fb3ef03-9995-433c-a4b3-0735457dc609";
            (function(){d=document;s=d.createElement("script");
            s.src="https://client.crisp.chat/l.js";
            s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();
    </script>
</body>
</html>
