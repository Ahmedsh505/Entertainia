@model Core.Models.Venue
@using Core.Helpers

@{
    ViewData["Title"] = "Venue Details";
    var photos = ViewBag.Photos as List<Core.Models.PhotoModels.VenuePhoto> ?? new List<Core.Models.PhotoModels.VenuePhoto>();
    var videos = ViewBag.Videos as List<Core.Models.VideoModels.VenueVideo> ?? new List<Core.Models.VideoModels.VenueVideo>();
    var venueEvents = ViewBag.VenueEvents as List<Core.Models.EventModels.EventBase> ?? new List<Core.Models.EventModels.EventBase>();
    var hasMedia = photos.Any() || videos.Any();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Venue/VenueDetails.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
}

<!-- ========================================
     IMMERSIVE HERO GALLERY BANNER
     ======================================== -->
<section class="venue-hero-gallery" id="venueHeroGallery">
    @if (hasMedia)
    {
        <!-- Media Display Container -->
        <div class="hero-media-display">
            <div class="hero-media-viewport" id="heroMediaViewport">
                <!-- Media injected by JavaScript -->
            </div>

            <!-- Side Thumbnails Strip -->
            <div class="hero-thumbnails-strip" id="heroThumbnailsStrip">
                <div class="thumbnails-scroll">
                    @* Photos First *@
                    @for (int i = 0; i < photos.Count; i++)
                    {
                        var photo = photos[i];
                        <div class="thumb-item @(i == 0 ? "active" : "")"
                             data-index="@i"
                             onclick="selectMedia(@i)">
                            <img src="@photo.FilePath" alt="@Model.Name" loading="lazy">
                            @if (photo.IsPrimary)
                            {
                                <span class="thumb-badge"><i class="fas fa-star"></i></span>
                            }
                        </div>
                    }

                    @* Videos with Play Icon *@
                    @for (int i = 0; i < videos.Count; i++)
                    {
                        var video = videos[i];
                        var mediaIndex = photos.Count + i;
                        <div class="thumb-item"
                             data-index="@mediaIndex"
                             onclick="selectMedia(@mediaIndex)">
                            <video class="img-fluid rounded" preload="metadata">
                                <source src="@video.FilePath" type="@video.ContentType" />
                            </video>
                            <div class="thumb-video-icon"><i class="fas fa-play-circle"></i></div>
                            @if (video.IsPrimary)
                            {
                                <span class="thumb-badge"><i class="fas fa-star"></i></span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Navigation Controls -->
            <button class="nav-btn prev" onclick="navigateMedia(-1)" aria-label="Previous">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="nav-btn next" onclick="navigateMedia(1)" aria-label="Next">
                <i class="fas fa-chevron-right"></i>
            </button>

            <!-- Control Buttons -->
            <div class="media-controls">
                <button class="control-btn" id="playPauseBtn" onclick="toggleAutoplay()" aria-label="Pause">
                    <i class="fas fa-pause"></i>
                </button>
                <button class="control-btn" onclick="toggleFullscreen()" aria-label="Fullscreen">
                    <i class="fas fa-expand"></i>
                </button>
            </div>

            <!-- Progress Bar -->
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>

            <!-- Media Counter -->
            <div class="media-counter">
                <span id="currentNum">1</span> / <span id="totalNum">@(photos.Count + videos.Count)</span>
            </div>
        </div>
    }
    else
    {
        <!-- Fallback Gradient -->
        <div class="hero-media-display">
            <div class="hero-fallback"></div>
        </div>
    }

    <!-- Info Overlay (Bottom 25%) -->
    <div class="hero-info-overlay">
        <div class="container">

            <!-- Venue Title -->
            <h1 class="venue-title">@Model.Name</h1>

            <!-- Badges Row -->
            <div class="badges-row">
                <span class="badge badge-governorate">
                    <i class="fas fa-map-marked-alt"></i>
                    @GovernorateHelper.GetDisplayName(Model.Governorate, includeArabic: false)
                </span>
                <span class="badge badge-capacity">
                    <i class="fas fa-users"></i>
                    @Model.Capacity.ToString("N0") Capacity
                </span>
                <span class="badge badge-status @(Model.ApprovalStatus == Core.Enums.ApprovalStatus.Approved ? "approved" : Model.ApprovalStatus == Core.Enums.ApprovalStatus.Pending ? "pending" : "rejected")">
                    <i class="fas fa-shield-check"></i>
                    @Model.ApprovalStatus
                </span>
            </div>

            <!-- Quick Info Grid -->
            <div class="quick-info-grid">
                <div class="info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <span class="label">Location</span>
                        <span class="value">@Model.Location</span>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-calendar-check"></i>
                    <div>
                        <span class="label">Total Events</span>
                        <span class="value">@venueEvents.Count Event(s)</span>
                    </div>
                </div>
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div class="info-item">
                        <i class="fas fa-location-arrow"></i>
                        <div>
                            <span class="label">Coordinates</span>
                            <span class="value">@Model.Latitude.Value.ToString("F4"), @Model.Longitude.Value.ToString("F4")</span>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

<!-- ========================================
     MAIN CONTENT
     ======================================== -->
<div class="venue-content">
    <div class="container">
        <div class="content-grid">

            <!-- ===== LEFT COLUMN: MAIN INFO ===== -->
            <div class="content-main">

                <!-- Venue Information Card -->
                <div class="content-card fade-in">
                    <div class="card-header">
                        <h2 class="card-title">
                            <i class="fas fa-info-circle"></i>
                            Venue Information
                        </h2>
                    </div>
                    <div class="card-body">
                        <div class="info-grid">
                            <div class="info-block">
                                <div class="info-label">
                                    <i class="fas fa-building"></i>
                                    Venue Name
                                </div>
                                <div class="info-content">@Model.Name</div>
                            </div>

                            <div class="info-block">
                                <div class="info-label">
                                    <i class="fas fa-map-pin"></i>
                                    Governorate
                                </div>
                                <div class="info-content">
                                    @GovernorateHelper.GetDisplayName(Model.Governorate, includeArabic: true)
                                </div>
                            </div>

                            <div class="info-block">
                                <div class="info-label">
                                    <i class="fas fa-map-marker-alt"></i>
                                    Full Address
                                </div>
                                <div class="info-content">@Model.Location</div>
                            </div>

                            <div class="info-block">
                                <div class="info-label">
                                    <i class="fas fa-users"></i>
                                    Maximum Capacity
                                </div>
                                <div class="info-content">@Model.Capacity.ToString("N0") Guests</div>
                            </div>
                        </div>

                        <!-- Capacity Visualization -->
                        <div class="capacity-visualization">
                            <div class="capacity-header">
                                <h4><i class="fas fa-chart-bar"></i> Capacity Meter</h4>
                                <span class="capacity-number">@Model.Capacity.ToString("N0")</span>
                            </div>
                            <div class="capacity-bar-container">
                                <div class="capacity-bar-fill" style="width: 100%;">
                                    <span class="capacity-label">Full Capacity</span>
                                </div>
                            </div>
                            <div class="capacity-legend">
                                <div class="legend-item">
                                    <span class="legend-color" style="background: linear-gradient(90deg, var(--color-accent-start), var(--color-accent-end));"></span>
                                    <span>Maximum</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Related Events Section -->
                @if (venueEvents.Any())
                {
                    <div class="content-card fade-in">
                        <div class="card-header">
                            <h2 class="card-title">
                                <i class="fas fa-calendar-alt"></i>
                                Events at this Venue
                            </h2>
                            <span class="badge badge-count">@venueEvents.Count</span>
                        </div>
                        <div class="card-body">
                            <div class="events-grid">
                                @foreach (var evt in venueEvents)
                                {
                                    <div class="event-card">
                                        <div class="event-card-header">
                                            <h3 class="event-card-title">@evt.Title</h3>
                                            <span class="event-category badge">
                                                @evt.Category
                                            </span>
                                        </div>
                                        <div class="event-card-body">
                                            <div class="event-detail">
                                                <i class="fas fa-calendar"></i>
                                                <span>@evt.StartDate.ToString("MMM dd, yyyy")</span>
                                            </div>
                                            <div class="event-detail">
                                                <i class="fas fa-clock"></i>
                                                <span>@evt.StartDate.ToString("hh:mm tt") - @evt.EndDate.ToString("hh:mm tt")</span>
                                            </div>
                                            <div class="event-detail">
                                                <i class="fas fa-shield-check"></i>
                                                <span class="status-badge @(evt.ApprovalStatus == Core.Enums.ApprovalStatus.Approved ? "approved" : evt.ApprovalStatus == Core.Enums.ApprovalStatus.Pending ? "pending" : "rejected")">
                                                    @evt.ApprovalStatus
                                                </span>
                                            </div>
                                        </div>
                                        <div class="event-card-footer">
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@evt.EventId" class="btn-view-event">
                                                <i class="fas fa-eye"></i>
                                                View Event
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="content-card fade-in">
                        <div class="card-header">
                            <h2 class="card-title">
                                <i class="fas fa-calendar-alt"></i>
                                Events at this Venue
                            </h2>
                        </div>
                        <div class="card-body">
                            <div class="empty-state">
                                <i class="fas fa-calendar-times"></i>
                                <h3>No Events Yet</h3>
                                <p>This venue doesn't have any scheduled events at the moment.</p>
                            </div>
                        </div>
                    </div>
                }

            </div>

            <!-- ===== RIGHT SIDEBAR ===== -->
            <div class="content-sidebar">

                <!-- Interactive Map Card -->
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div class="sidebar-card fade-in">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-map"></i>
                                Location Map
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="venue-location-info">
                                <div class="location-item">
                                    <i class="fas fa-map-marked-alt"></i>
                                    <span>@GovernorateHelper.GetDisplayName(Model.Governorate, includeArabic: false)</span>
                                </div>
                                <div class="location-item">
                                    <i class="fas fa-map-pin"></i>
                                    <span>@Model.Location</span>
                                </div>
                                <div class="location-item">
                                    <i class="fas fa-location-arrow"></i>
                                    <span>@Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")</span>
                                </div>
                            </div>

                            <div class="map-wrapper">
                                <div id="venueMap" class="venue-map"></div>
                            </div>

                            <button class="btn-directions" id="directionsBtn">
                                <i class="fas fa-route"></i>
                                Get Directions
                            </button>
                        </div>
                    </div>
                }

                <!-- Stats Card -->
                <div class="sidebar-card fade-in">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-line"></i>
                            Quick Stats
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="stats-list">
                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">Capacity</span>
                                    <span class="stat-value">@Model.Capacity.ToString("N0")</span>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">Total Events</span>
                                    <span class="stat-value">@venueEvents.Count</span>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-shield-check"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">Status</span>
                                    <span class="stat-value status-@Model.ApprovalStatus.ToString().ToLower()">
                                        @Model.ApprovalStatus
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Share Card -->
                <div class="sidebar-card fade-in">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-share-nodes"></i>
                            Share Venue
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="share-grid">
                            <button class="share-btn facebook" onclick="shareVenue('facebook')">
                                <i class="fab fa-facebook-f"></i>
                            </button>
                            <button class="share-btn twitter" onclick="shareVenue('twitter')">
                                <i class="fab fa-twitter"></i>
                            </button>
                            <button class="share-btn whatsapp" onclick="shareVenue('whatsapp')">
                                <i class="fab fa-whatsapp"></i>
                            </button>
                            <button class="share-btn link" onclick="copyLink()">
                                <i class="fas fa-link"></i>
                            </button>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- Action Buttons -->
        <div class="action-btns">
            @if (User.IsInRole("Admin") || (User.IsInRole("Organizer") && Model.CreatedByUserId == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0")))
            {
                <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn-action edit">
                    <i class="fas fa-edit"></i>
                    <span>Edit Venue</span>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.VenueId" class="btn-action delete">
                    <i class="fas fa-trash"></i>
                    <span>Delete</span>
                </a>
            }
            <a asp-action="Index" class="btn-action back">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Venues</span>
            </a>
        </div>

    </div>
</div>

<!-- Fullscreen Modal -->
<div class="fullscreen-modal" id="fullscreenModal" onclick="closeFullscreen()">
    <button class="modal-close" onclick="closeFullscreen()">
        <i class="fas fa-times"></i>
    </button>
    <div class="modal-content" id="modalContent" onclick="event.stopPropagation()">
        <!-- Media injected here -->
    </div>
    <div class="modal-nav">
        <button onclick="event.stopPropagation(); navigateMedia(-1);">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button onclick="event.stopPropagation(); navigateMedia(1);">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
        // Media Data
        const mediaItems = [
            @foreach (var photo in photos)
            {
                    @:{ type: 'photo', src: '@photo.FilePath', isPrimary: @photo.IsPrimary.ToString().ToLower() },
            }
            @foreach (var video in videos)
            {
                    @:{ type: 'video', src: '@video.FilePath', contentType: '@(video.ContentType ?? "video/mp4")', isPrimary: @video.IsPrimary.ToString().ToLower() },
            }
        ];

        // Venue Data
        const venueData = {
            lat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Latitude)),
            lng: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Longitude)),
            name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)),
            location: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Location)),
            capacity: @Model.Capacity
        };
    </script>
    <script src="~/js/VenueDetails.js" asp-append-version="true"></script>
}
