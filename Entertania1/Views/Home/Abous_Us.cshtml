@{
    ViewData["Title"] = "About Entertania";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home/AboutUs.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lora:wght@400;600&display=swap" rel="stylesheet">
}

<!-- Hero Section with Modern Design -->
<section class="about-hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-badge">
                <i class="fas fa-star"></i> ABOUT ENTERTANIA
            </div>
            <h1 class="about-hero-title">
                Revolutionizing Event Experiences
            </h1>
            <p class="about-hero-subtitle">
                Connecting passionate audiences with unforgettable moments through cutting-edge technology and seamless booking experiences
            </p>

            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">10K+</span>
                    <span class="hero-stat-label">Tickets Sold</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">500+</span>
                    <span class="hero-stat-label">Events Hosted</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">5K+</span>
                    <span class="hero-stat-label">Happy Customers</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission Section with Bento Grid Layout -->
<section class="mission-section">
    <div class="container">
        <div class="mission-grid">
            <div class="mission-visual">
                <div class="mission-icon-large">
                    <i class="fas fa-bullseye"></i>
                </div>
            </div>

            <div class="mission-content">
                <h2>Our Mission</h2>
                <p>
                    At Entertania, we're transforming how people discover and experience events.
                    We believe unforgettable moments should be effortless to find and book.
                </p>
                <p>
                    Our platform seamlessly connects event organizers with enthusiastic audiences,
                    offering concerts, sports, theater, cultural activities, and tourism experiences—all in one place.
                </p>

                <div class="mission-highlights">
                    <div class="highlight-item">
                        <div class="highlight-icon">
                            <i class="fas fa-rocket"></i>
                        </div>
                        <span class="highlight-text">Cutting-edge booking technology</span>
                    </div>
                    <div class="highlight-item">
                        <div class="highlight-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <span class="highlight-text">Secure and hassle-free transactions</span>
                    </div>
                    <div class="highlight-item">
                        <div class="highlight-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <span class="highlight-text">World-class customer experience</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section with Enhanced Cards -->
<section class="values-section">
    <div class="container">
        <div class="section-header">
            <div class="section-badge">OUR DNA</div>
            <h2 class="section-title">Core Values</h2>
            <p class="section-subtitle">
                The principles that drive everything we do at Entertania
            </p>
        </div>

        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon-wrapper">
                    <i class="fas fa-users value-icon"></i>
                </div>
                <h3 class="value-title">Customer First</h3>
                <p class="value-description">
                    Every decision starts with our customers and organizers in mind.
                    We deliver exceptional experiences that exceed expectations.
                </p>
            </div>

            <div class="value-card">
                <div class="value-icon-wrapper">
                    <i class="fas fa-rocket value-icon"></i>
                </div>
                <h3 class="value-title">Innovation</h3>
                <p class="value-description">
                    We embrace cutting-edge technology and creative solutions to
                    continuously improve and stay ahead in the industry.
                </p>
            </div>

            <div class="value-card">
                <div class="value-icon-wrapper">
                    <i class="fas fa-shield-alt value-icon"></i>
                </div>
                <h3 class="value-title">Trust & Security</h3>
                <p class="value-description">
                    Your security is our priority. We implement robust measures
                    to protect your data and transactions.
                </p>
            </div>

            <div class="value-card">
                <div class="value-icon-wrapper">
                    <i class="fas fa-lightbulb value-icon"></i>
                </div>
                <h3 class="value-title">Excellence</h3>
                <p class="value-description">
                    We pursue excellence in every aspect, from platform performance
                    to customer support, ensuring quality at every touchpoint.
                </p>
            </div>

            <div class="value-card">
                <div class="value-icon-wrapper">
                    <i class="fas fa-globe value-icon"></i>
                </div>
                <h3 class="value-title">Accessibility</h3>
                <p class="value-description">
                    Amazing events should be accessible to everyone. Our platform
                    is designed to be inclusive, intuitive, and available to all.
                </p>
            </div>

            <div class="value-card">
                <div class="value-icon-wrapper">
                    <i class="fas fa-handshake value-icon"></i>
                </div>
                <h3 class="value-title">Partnership</h3>
                <p class="value-description">
                    We build lasting relationships with organizers, venues, and customers,
                    working together to create memorable experiences.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Team Section with Modern Cards -->
<section class="team-section">
    <div class="container">
        <div class="section-header">
            <div class="section-badge">THE TEAM</div>
            <h2 class="section-title">Meet Our Leadership</h2>
            <p class="section-subtitle">
                The passionate individuals driving Entertania's success
            </p>
        </div>

        <div class="team-grid">
            <div class="team-member">
                <div class="member-avatar">AS</div>
                <h3 class="member-name">Ahmed Sherif</h3>
                <span class="member-role">
                    <i class="fas fa-crown"></i> Co-Founder & CEO
                </span>
                <p class="member-bio">
                    Visionary leader with a passion for technology and entertainment.
                    Ahmed drives Entertania's strategic direction and global expansion.
                </p>
            </div>

            <div class="team-member">
                <div class="member-avatar">AT</div>
                <h3 class="member-name">Ahmed Tamer</h3>
                <span class="member-role">
                    <i class="fas fa-crown"></i> Co-Founder & CTO
                </span>
                <p class="member-bio">
                    Technical mastermind who architects the scalable solutions
                    powering Entertania's platform globally.
                </p>
            </div>

            <div class="team-member">
                <div class="member-avatar">MA</div>
                <h3 class="member-name">Mohamed Ashraf</h3>
                <span class="member-role">
                    <i class="fas fa-cogs"></i> Senior Developer
                </span>
                <p class="member-bio">
                    Full-stack specialist ensuring peak performance, stability,
                    and implementing cutting-edge features.
                </p>
            </div>

            <div class="team-member">
                <div class="member-avatar">YM</div>
                <h3 class="member-name">Youssef Mohamed</h3>
                <span class="member-role">
                    <i class="fas fa-code"></i> Software Engineer
                </span>
                <p class="member-bio">
                    Expert in modern UI/UX design and high-performance
                    frontend development.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section with Gradient Background -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2 class="cta-title">Ready for Amazing Events?</h2>
            <p class="cta-subtitle">
                Join thousands of event enthusiasts who trust Entertania
                for their entertainment needs
            </p>
            <div class="cta-buttons">
                <a asp-controller="Events" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-calendar-alt"></i>
                    Browse Events
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline">
                    <i class="fas fa-user-plus"></i>
                    Join Entertania
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section with Modern Layout -->
<section class="contact-section">
    <div class="container">
        <div class="contact-wrapper">
            <div class="contact-header">
                <h2 class="contact-title">Get In Touch</h2>
                <p class="section-subtitle">We'd love to hear from you</p>
            </div>

            <div class="contact-grid">
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div class="contact-text">
                        <span class="contact-label">Phone</span>
                        <span class="contact-value">+20 10 929 60 582</span>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div class="contact-text">
                        <span class="contact-label">Phone</span>
                        <span class="contact-value">+20 10 954 58 693</span>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div class="contact-text">
                        <span class="contact-label">Email</span>
                        <span class="contact-value">EntertaniaTeam@gmail.com</span>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="contact-text">
                        <span class="contact-label">Location</span>
                        <span class="contact-value">القومية - الزقازيق</span>
                    </div>
                </div>
            </div>

            <div class="map-wrapper">
                <h5 class="map-title">Find Us On The Map</h5>
                <div class="map-container">
                    <iframe src="https://www.google.com/maps?q=القومية%20-%20الزقازيق&output=embed"
                            allowfullscreen
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>